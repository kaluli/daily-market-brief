# Base de datos (por defecto ya usado por la API si no se define)
# DATABASE_URL=postgres://marketbrief:marketbrief_secret@localhost:5432/marketbrief?sslmode=disable
#
# Neon (local/producción): ver docs/LOCAL_NEON.md y .env.neon.example → archivo .env.neon en la raíz
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# API (solo si corrés la API en otro host/puerto)
# PORT=3090
# SUMMARIES_PATH=./summaries

# Ingesta: fuentes que requieren API key (opcional; RSS como CNBC no requiere key)
# NEWSAPI_KEY=
# FINNHUB_API_KEY=

# Investment analyst: elige el proveedor de LLM.
# Dejalo todo sin definir para usar el stub (sin costo, valores placeholder).
# LLM_PROVIDER=ollama   # ollama | openai | stub (si no se define, se autodetecta)

# --- Opción A: Ollama local/LAN (gratis, sin API key) ---
# Ver docs/LOCAL_OLLAMA.md para exponerlo en la red si corre en otra PC.
# OLLAMA_BASE_URL=http://192.168.1.50:11434
# OLLAMA_MODEL=llama3.2:3b

# Agentes (Fase 4): cuantas noticias del dia (las de mayor impact_score) se
# mandan al LLM por dia analizado. Mas alto = mas preciso pero mas lento con
# un modelo local. Default: 25.
# AGENTS_MAX_NEWS_PER_DAY=25

# --- Opción B: OpenAI (de pago) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Web: URL de la API (solo necesario si la API no está en localhost:3090)
# NEXT_PUBLIC_API_URL=http://localhost:3090

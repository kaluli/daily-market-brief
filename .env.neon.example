# Copiá este archivo a `.env.neon` en la raíz del repo (está en .gitignore).
# Pegá la connection string de Neon (Dashboard → proyecto → Connection string).
# Formato típico: postgresql://usuario:contraseña@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
#
# En Neon podés crear una base nueva para Daily Market Brief o reutilizar la misma
# organización/proyecto que usás para asistente / scraper idealista (base distinta recomendada).

DATABASE_URL=
